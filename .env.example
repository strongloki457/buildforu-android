# ── Frontend environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Backend API base URL (no trailing slash)
# In development the Vite proxy rewrites /api/* to localhost:5000 automatically.
# In production set this to your deployed API URL.
VITE_API_URL=http://localhost:5000

# Demo accounts — enable only in development/staging, never in production
# VITE_ENABLE_DEMO_ACCOUNTS=true
# VITE_DEMO_PASSWORD_ADMIN=
# VITE_DEMO_PASSWORD_EMPLOYEE=
