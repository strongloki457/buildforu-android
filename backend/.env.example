DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildforu?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PORT=5000
NODE_ENV="development"

# Email (SMTP) — leave empty in development to log emails to console instead
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_FROM=noreply@buildforu.com
