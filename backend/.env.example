# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildforu?schema=public"

# ── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ── Frontend origin (comma-separated for multiple origins) ──────────────────
FRONTEND_URL="http://localhost:5173"

# ── AI Assistant (Groq — free tier: https://console.groq.com) ───────────────
GROQ_API_KEY="gsk_replace-with-your-groq-api-key"

# ── Email / SMTP (leave empty in development to log emails to console) ───────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_FROM=noreply@buildforu.com
