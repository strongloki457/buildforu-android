# Copy this file to keystore.properties (same folder) and fill in your real values.
# keystore.properties is gitignored — never commit it or the .jks/.keystore file itself.
#
# Generate a release keystore once with:
#   keytool -genkey -v -keystore buildforu-release.jks -keyalias buildforu -keyalg RSA -keysize 2048 -validity 10000
#
# Store the resulting .jks file outside the repo (or in android/ which is also gitignored for *.jks)
# and back it up somewhere safe — losing it means you can never update the published app again.

storeFile=/absolute/path/to/buildforu-release.jks
storePassword=changeit
keyAlias=buildforu
keyPassword=changeit
